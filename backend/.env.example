# Copie este arquivo para .env e preencha com os dados
PORT=3000
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGODB_DB=minha_colheita
# Assina o token de login. Tem que ser o mesmo pra todo o time e nunca pode ir pro GitHub
JWT_SECRET=troque-por-um-texto-grande-e-aleatorio

# Envio de e-mail (recuperação de senha). Sem SMTP_HOST, o código aparece só no terminal da API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=